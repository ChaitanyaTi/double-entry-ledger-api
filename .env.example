# Server Configuration
PORT=3000

# MongoDB Connection URI (Replica Set recommended for MongoDB multi-document transactions)
MONGO_URI=mongodb://localhost:27017/backend-ledger

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Gmail OAuth2 Email Configuration (Optional - emails will be logged if not set)
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_oauth_client_id
CLIENT_SECRET=your_oauth_client_secret
REFRESH_TOKEN=your_oauth_refresh_token
